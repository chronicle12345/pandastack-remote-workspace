# PandaStack 一键部署配置
# 本模板不含真实密钥。复制为 .env 后填写本地配置。

# PandaStack API Key。留空时部署脚本会安全提示输入。
PDS_API_KEY=

# 留空表示新建 App；填写已有 App ID 表示更新该 App。
PDS_APP_ID=

# PandaStack 返回的公网地址（含 https://），部署后自动写回。留空时使用 App ID 域名。
PDS_PUBLIC_URL=

# App 名称必须唯一，建议只使用小写字母、数字和连字符。
PDS_APP_NAME=pandastack-browser

# PandaStack 的 git_url 必填项，默认使用 noVNC 仓库。
PDS_GIT_URL=https://github.com/novnc/noVNC.git
PDS_GIT_BRANCH=master
PDS_TEMPLATE=browser
PDS_PORT=6080
PDS_IDLE_TIMEOUT_SECONDS=1800
PDS_AUTO_HIBERNATE=true

# 网页登录会话有效期，单位分钟。默认 180，范围 1 到 10080。
SESSION_TTL_MINUTES=180

# 网页登录密码。留空时脚本会生成 32 位随机密码并写回本文件。
BROWSER_PASSWORD=

# root 账户密码。留空时脚本会生成 32 位随机密码并写回本文件。
# root 密码用于本地控制台和 su -；SSH 使用 root 公钥登录。
ROOT_PASSWORD=

# SSH 公钥路径，默认使用当前目录。首次部署会自动生成密钥；填 off 可禁用 SSH。
SSH_PUBLIC_KEY_PATH=.\pandastack-root.pub

# 可选：工作区加密快照。两项都填写才会启用；留空会删除远端旧的工作区 secret。
# WORKSPACE_DATABASE_URL 例：postgresql://<连接串>
# WORKSPACE_KEY 必须是 Fernet 密钥，即 32 字节随机值的 Base64。
WORKSPACE_DATABASE_URL=
WORKSPACE_KEY=
WORKSPACE_ID=pandastack-workspace
